{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Flask",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development",
        "PORT": "80",
        "FLASK_RUN_PORT": "80",
        "FLASK_RUN_HOST": "0.0.0.0"
      }
    }
  ]
}


